# ── Secrets ──────────────────────────────────────────────────────────────
.env
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Generated data (rebuildable — not tracked) ──────────────────────────
data/index/*
!data/index/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Raw 3GPP PDFs are often large and may carry redistribution restrictions —
# keep the folder, ignore its contents, and let each user supply their own.
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep
!data/raw_pdfs/sample_corpus/

# ── Logs & eval output ──────────────────────────────────────────────────
logs/*
!logs/.gitkeep
eval/results/*
!eval/results/.gitkeep

# ── Editors / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Node (web UI tooling, if added later) ───────────────────────────────
node_modules/
